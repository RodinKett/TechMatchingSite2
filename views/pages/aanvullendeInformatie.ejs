<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>EJS Is Fun</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/aanvulende-gegevens.css">
  <link rel="stylesheet" href="/header.css">
</head>
<body class="container">

<header>
    <%- include('../partials/headerbasis.ejs'); %>
</header>

<main>
    <form id="formulier-aanvullende-gegevens" action="/aanvullendeInformatie" method="POST">
        <h2 id="titel-aanvullende-gegevens-stap1">Aanvullende persoons gegevens</h2>

        <label for="jarenErvaring">Jaren ervaring</label>
        <input id="jarenErvaring" type="number" name="jarenErvaring" required  min="0" max="99" >
        <p class="error-jarenErvaring" style="display:none;"></p>

        <label for="specialisatie">Specialisatie</label>
        <div>
          <label class="checkbox"><input type="checkbox" name="specialisatie" value="Circuit racing" required> Circuit racing</label>
          <label class="checkbox"><input type="checkbox" name="specialisatie" value="Drag racing"> Drag racing</label>
          <label class="checkbox"><input type="checkbox" name="specialisatie" value="Drift racing"> Drift racing</label>
          <label class="checkbox"><input type="checkbox" name="specialisatie" value="Rally"> Rally</label>
          <label class="checkbox"><input type="checkbox" name="specialisatie" value="Endurance racing"> Endurance racing</label>
        </div>
        <p class="error-specialisatie" style="display:none;"></p>

        <label for="aanvullendeOpmerkingen">Over mij</label>
        <input id="aanvullendeOpmerkingen" type="text" name="aanvullendeOpmerkingen">
        <p class="error-aanvullendeOpmerkingen" style="display:none;"></p>

        <span></span>
      <!--------------------------------------------------------------------------------------->
        <h2 id="titel-aanvullende-gegevens-stap2">Voertuig</h2>

        <label for="jaartalVoertuig">Jaartal voertuig</label>
        <input id="jaartalVoertuig"type="number" name="jaartalVoertuig" required min="1950" max="2025" step="1">
        <p class="error-jaartalVoertuig" style="display:none;"></p>

        <label for="merkVoertuig-api">Merk voertuig</label>
        <select id="merkVoertuig-api" name="merkVoertuig-api" required>
          <option value="beginer">Select merk</option>
        </select>
        <p class="error-merkVoertuig-api" style="display:none;"></p>

        <label for="voertuig-api">Voertuig</label>
        <select id="voertuig-api" name="voertuig-api" required>
          <option value="beginer">Select model</option>
        </select>
        <p class="error-voertuig-api" style="display:none;"></p>

        <input type="hidden" name="pk" id="pk">
        <input type="hidden" name="gewicht" id="gewicht">
        <input type="hidden" name="aandrijving" id="aandrijving">

        <label for="mods">Mods</label>
        <div>
          <label class="checkbox"><input type="checkbox" name="mods" value="Tires"> Tires</label>
          <label class="checkbox"><input type="checkbox" name="mods" value="Suspension"> Suspension</label>
          <label class="checkbox"><input type="checkbox" name="mods" value="Brakes"> Brakes</label>
          <label class="checkbox"><input type="checkbox" name="mods" value="Power"> Power</label>
          <label class="checkbox"><input type="checkbox" name="mods" value="Aero"> Aero</label>
        </div>
        <p class="error-mods" style="display:none;"></p>

        <button type="submit" onclick="formatValidatie(event)">Opslaan</button>
    </form>
</main>

<footer></footer>
<script src="/js/car-api.js"></script>
<script src="/js/formatValidatie.js"></script>
</body>
</html>
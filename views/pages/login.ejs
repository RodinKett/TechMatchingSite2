<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>EJS Is Fun</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/login-register.css">
</head>
<body>

<header>
</header>

<main>
  <section class="container" id="container">

    <!-- Inloggen -->
    <section class="sectie" aria-labelledby="titel-inloggen">
      <form class="formulier-box-login" action="/login" method="POST">
        <h2 id="titel-inloggen">Inloggen</h2>

        <label for="inlog-gebruikersnaam">Gebruikersnaam</label>

        <input id="inlog-gebruikersnaam" type="text" name="username" required>
        <p class="error-inlog-gebruikersnaam" style="display:none;"></p>
        

        <label for="inlog-wachtwoord">Wachtwoord</label>
        <input id="inlog-wachtwoord" type="password" name="password" required>
        <p class="error-inlog-wachtwoord" style="display:none;"></p>

        <button type="submit" onclick="validateLogin(event)">Inloggen</button>


        <button type="button" class="link" onclick="gaNaar(1)">
          Nog geen account? <u><strong>Registreer</strong></u>
        </button>
      </form>
    </section>

    <!-- Registratie Stap 1 -->
    <section class="sectie" aria-labelledby="titel-registratie-stap1">

      <form class="formulier-box formulier-box-register" id="formulier-registratie" action="/register" method="POST" enctype="multipart/form-data">

      <fieldset class="stap" id="stap1" style="display:none;">
        <h2 id="titel-registratie-stap1">Registreren - Stap 1</h2>

        <label for="reg-gebruikersnaam">Gebruikersnaam</label>

        <input id="reg-gebruikersnaam" type="text" name="reg-gebruikersnaam" required>
        <p class="error-reg-gebruikersnaam" style="display:none;"></p>

        <label for="reg-email">Email</label>
        <input id="reg-email" type="email" name="email" required>
        <p class="error-reg-email" style="display:none;"></p>

        <div>
          <button type="button" class="knop-primaire" onclick="if(validateRegisterStep1()) gaNaar(2)">Volgende</button>

          <button type="button" class="link" onclick="gaTerugNaar(0)">
            Heb je al een account <u><strong>log hier in</strong></u>      
          </button>
        </div>
      </fieldset>

      <!-- Stap 2 -->
      <fieldset class="stap" id="stap2" style="display:none;">
        <h2 id="titel-registratie-stap2">Registreren - Stap 2</h2>

        <label for="reg-geboortedatum">Geboortedatum</label>
        <input id="reg-geboortedatum" type="date" name="dob" required>


        <p class="error-reg-dob" style="display:none;"></p>

        <label for="profielUpload">Upload profielfoto</label>
        <!-- File input -->
        <input type="file" id="profielUpload"  name="profielFoto" accept="image/*">

        <!-- Label triggers the input -->
        <label for="profielUpload" class="upload-label">
          <img src="afbeeldingen/upload-photo.svg" alt="Upload Profiel">
          <span class="file-name">Upload profielfoto</span>
        </label>
        <p class="error-upload-foto" style="display:none;"></p>


        <div>
          <div class="knoppen-rij">
            <button type="button" class="knop-secundaire" onclick="gaNaar(1)">Terug</button>
            <button type="button" class="knop-primaire" onclick="if(validateRegisterStep2()) gaNaar(3)">Volgende</button>

          </div>
          <button type="button" class="link" onclick="gaTerugNaar(0)">
            Heb je al een account <u><strong>log hier in</strong></u>       
          </button>
        </div>
      </fieldset>

      <!-- Stap 3 -->
      <fieldset class="stap" id="stap3" style="display:none;">
        <h2 id="titel-registratie-stap3">Registreren - Stap 3</h2>

        <label for="reg-wachtwoord">Wachtwoord</label>

        <input id="reg-wachtwoord" type="password" name="reg-password" required >
        <p class="error-reg-password" style="display:none;"></p>

        <label for="reg-wachtwoord-bevestigen">Bevestig wachtwoord</label>
        <input id="reg-wachtwoord-bevestigen" type="password" name="reg-wachtwoord-bevestigen" required >
        <p class="error-reg-password-bevestigen" style="display:none;"></p>


        <div>
          <div class="knoppen-rij">
            <button type="button" class="knop-secundaire" onclick="gaNaar(2)">Terug</button>
            <button type="submit" class="knop-primaire" onclick="validateRegisterStep3(event)">Registreren</button>
          </div>
          <p class="error-reg-general " style="display:none; "></p>

          <button type="button" class="link" onclick="gaTerugNaar(0)">
            Heb je al een account <u><strong>log hier in</strong></u>       
          </button>
        </div>
      </fieldset>
    </form>
    </section>

  </section>
</main>

<script src="/js/format-validatie.js"></script>
<script src="/js/login-register.js"></script>

<footer>
</footer>

</body>
</html>
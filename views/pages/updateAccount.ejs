<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Update Account</title>

  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/updateProfile.css">
  <link rel="stylesheet" href="/header.css">
</head>

<body class="container">

  <header>
    <%- include('../partials/headerbasis.ejs'); %>
  </header>

  <main>

    <h1>Update account</h1>

    <form id="formulier-aanvullende-gegevens" action="/updateAccount" method="POST" enctype="multipart/form-data">

      <!-- ACCOUNT DATA -->
      <div class="accordion open">
        <h2 class="accordion-header">Account gegevens</h2>
        <div class="accordion-content">

          <label for="update-email">Email</label>
          <input id="update-email" type="email" name="email" value="<%= user.email %>" >
          <p class="error-email" style="display:none;"></p>

          <label for="huidig-wachtwoord">Huidig wachtwoord</label>
          <input type="password" id="huidig-wachtwoord" name="huidig-wachtwoord">
          <p class="error-huidig-wachtwoord" style="display:none;"></p>

          <label for="nieuw-wachtwoord">Nieuw wachtwoord</label>
          <input id="nieuw-wachtwoord" type="password" name="nieuw-wachtwoord" placeholder="Laat leeg als je niet wil wijzigen">
          <p class="error-nieuw-wachtwoord" style="display:none;"></p>

          <label for="bevestig-wachtwoord">Bevestig wachtwoord</label>
          <input id="bevestig-wachtwoord" type="password" name="bevestig-wachtwoord" placeholder="Bevestig nieuw wachtwoord">
          <p class="error-bevestig-wachtwoord" style="display:none;"></p>

          <label for="upload-profiel">Upload profielfoto</label>
          <input type="file" id="upload-profiel" name="profielFoto" accept="image/*">
          <p class="error-profielFoto" style="display:none;"></p>

          <label for="upload-profiel" class="upload-label">
            <img src="afbeeldingen/upload-photo.svg" alt="Upload Profiel foto">
            <span class="file-name">Upload profielfoto</span>
          </label>
          <img id="previewImage" class="voorbeeld-afbeelding" src="/uploads/<%= user.profielFoto %>">

        </div>
      </div>

      <span></span>

      <!-- PERSON DATA -->
      <div class="accordion">
        <h2 class="accordion-header">Aanvullende persoons gegevens</h2>
        <div class="accordion-content">

          <label for="jarenErvaring">Jaren ervaring</label>
          <input id="jarenErvaring" type="number" name="jarenErvaring" value="<%= user.jarenErvaring %>" required min="0" max="99">
          <p class="error-jarenErvaring" style="display:none;"></p>

          <fieldset >
            <legend>specialisatie</legend>
            
            <label class="checkbox"><input type="checkbox" name="specialisatie" value="Circuit racen" <%= user.specialisatie?.includes("Circuit racen") ? "checked" : "" %>> Circuit racen</label>
            <label class="checkbox"><input type="checkbox" name="specialisatie" value="Drag racen" <%= user.specialisatie?.includes("Drag racen") ? "checked" : "" %>> Drag racen</label>
            <label class="checkbox"><input type="checkbox" name="specialisatie" value="Drift racen" <%= user.specialisatie?.includes("Drift racen") ? "checked" : "" %>> Drift racen</label>
            <label class="checkbox"><input type="checkbox" name="specialisatie" value="Rally" <%= user.specialisatie?.includes("Rally") ? "checked" : "" %>> Rally</label>
            <label class="checkbox"><input type="checkbox" name="specialisatie" value="Uithoudingsracen" <%= user.specialisatie?.includes("Uithoudingsracen") ? "checked" : "" %>> Uithoudingsracen</label>
            <label class="checkbox"><input type="checkbox" name="specialisatie" value="Geen" <%= user.specialisatie?.includes("Geen") ? "checked" : "" %>> Geen</label>
          </fieldset>
          <p class="error-specialisatie" style="display:none;"></p>

          <label for="aanvullendeOpmerkingen">Over mij</label>
          <input id="aanvullendeOpmerkingen" type="text" name="aanvullendeOpmerkingen" value="<%= user.voertuig?.opmerkingen || '' %>">
          <p class="error-aanvullendeOpmerkingen" style="display:none;"></p>

        </div>
      </div>

      <span></span>

      <!-- VOERTUIG DATA -->
      <div class="accordion">
        <h2 class="accordion-header">Voertuig</h2>
        <div class="accordion-content">

          <label for="jaartalVoertuig">Jaartal voertuig</label>
          <input id="jaartalVoertuig" type="number" name="jaartalVoertuig" value="<%= user.voertuig?.jaartal || '' %>" min="1950" max="2025">
          <p class="error-jaartalVoertuig" style="display:none;"></p>

          <label for="merkVoertuig-api">Merk voertuig</label>
          <select id="merkVoertuig-api" name="merkVoertuig-api" data-huidig-merk="<%= user.voertuig?.merk || '' %>">
            <option value="">Selecteer merk</option>
          </select>
          <p class="error-merkVoertuig-api" style="display:none;"></p>

          <label for="voertuig-api">Model voertuig</label>
          <select id="voertuig-api" name="voertuig-api" data-huidig-model="<%= user.voertuig?.model || '' %>" disabled>
            <option value="">Selecteer model</option>
          </select>
          <p class="error-voertuig-api" style="display:none;"></p>

          <input type="hidden" name="pk" id="pk" value="<%= user.voertuig?.pk || '' %>">
          <input type="hidden" name="gewicht" id="gewicht" value="<%= user.voertuig?.gewicht || '' %>">
          <input type="hidden" name="aandrijving" id="aandrijving" value="<%= user.voertuig?.aandrijving || '' %>">

          <fieldset >
            <legend>Mods</legend>

            <label class="checkbox"><input type="checkbox" name="mods" value="Tires" <%= user.mods?.includes("Tires") ? "checked" : "" %>> Tires</label>
            <label class="checkbox"><input type="checkbox" name="mods" value="Suspension" <%= user.mods?.includes("Suspension") ? "checked" : "" %>> Suspension</label>
            <label class="checkbox"><input type="checkbox" name="mods" value="Brakes" <%= user.mods?.includes("Brakes") ? "checked" : "" %>> Brakes</label>
            <label class="checkbox"><input type="checkbox" name="mods" value="Power" <%= user.mods?.includes("Power") ? "checked" : "" %>> Power</label>
            <label class="checkbox"><input type="checkbox" name="mods" value="Aero" <%= user.mods?.includes("Aero") ? "checked" : "" %>> Aero</label>
            <label class="checkbox"><input type="checkbox" name="mods" value="Geen" <%= user.mods?.includes("Geen") ? "checked" : "" %>> Geen</label>
          </fieldset>
          <p class="error-mods" style="display:none;"></p>

        </div>
      </div>

      <button type="submit" onclick="validateUpdateAccount(event)">Opslaan</button>

    </form>

  </main>

  <script src="/js/car-api.js"></script>
  <script src="/js/format-validatie.js"></script>
  <script src="/js/update-account.js"></script>

  <footer></footer>

</body>

</html>
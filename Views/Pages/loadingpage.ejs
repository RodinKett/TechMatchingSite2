<!DOCTYPE html>
<html lang="en">
  <head>
  <meta charset="UTF-8">
  <title>Loading</title>

  <!-- CSS (load bootstrap from a CDN) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.5.2/css/bootstrap.min.css">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/header.css">

  <link rel="stylesheet" href="/loadingpage.css" />
  </head>
  <body>
    <header><%- include('../partials/headerbasis'); %></header>

    <main class="laadpagina">
    
      <section class="laadanimatie">
        <h1>De pagina is aan het laden</h1>

        <div class="cirkelanimatie"></div>
        <div class="cirkelanimatie2"></div>
        <div class="loader"></div>
        
        <picture class="caranimatie">
          <!--Stop hier een img in srcset Dit is voor wanneer je een bepaalde colorscheme gebruikt 
          en de gebruiker wisselt het om, dan blijf de animatie goed-->
          <source
          srcset="../../Afbeeldingen/cars-drift-animatie-003.png"
          media="(prefers-color-scheme: dark)"
          />
          <img
          src="../../Afbeeldingen/cars-drift-animatie-003.png"
          alt="laad animatie van een auto die rond draaid"
          />
        </picture>
      </section>
    </main>

    <!-- <footer></footer> -->
     <script src="../../static/js/loadingpage.js"></script>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>EJS Is Fun</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- CSS (load bootstrap from a CDN) -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.5.2/css/bootstrap.min.css"
    />
    <link rel="stylesheet" href="/style.css" />
    <link rel="stylesheet" href="/footer.css" />
  </head>
  <body class="body-matching">
    <header><%- include('../partials/headerbasis'); %></header>

    <main id="main-matching">
      <section id="alle-info">
        <section id="foto-section">
          
          <p>rank 95</p>
          <img
            src="/afbeeldingen/lightning-mcqueen.png"
            alt="Lightning McQueen"
          />
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="327"
            height="11"
            fill="none"
          >
            <path
              fill="#fff"
              d="m173.913.003 152.173.002v4.961l-157.155-.002zM167.335 5.956l158.751.003v4.961l-163.948-.002zM152.174 10.917 0 10.915V5.954l157.155.002zM158.751 4.964 0 4.962V0l163.948.002z"
            />
          </svg>
          <section id="naam-edit-profiel">
          <h2 id="naam-gebruiker">Lightning Mcqueen</h2>
          
          <svg id="edit-profiel" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M14 5C14 6.10457 13.1046 7 12 7C10.8954 7 10 6.10457 10 5C10 3.89543 10.8954 3 12 3C13.1046 3 14 3.89543 14 5Z" fill="#ffffff"></path> <path d="M14 12C14 13.1046 13.1046 14 12 14C10.8954 14 10 13.1046 10 12C10 10.8954 10.8954 10 12 10C13.1046 10 14 10.8954 14 12Z" fill="#ffffff"></path> <path d="M12 21C13.1046 21 14 20.1046 14 19C14 17.8954 13.1046 17 12 17C10.8954 17 10 17.8954 10 19C10 20.1046 10.8954 21 12 21Z" fill="#ffffff"></path> </g></svg>
        </section>
        </section>
        <section>
        
        <section id="info">
          <dl>
            <div class="info-blok">
              <dt>Voertuig:</dt>
              <dd>Gen 4 NASCAR</dd>
            </div>

            <div class="info-blok">
              <dt>PK</dt>
              <dd>260</dd>
            </div>

            <div class="info-blok">
              <dt>Jaar:</dt>
              <dd>2006</dd>
            </div>

            <div class="info-blok">
              <dt>Specialisatie:</dt>
              <dd>Bochten</dd>
            </div>

            <div class="info-blok">
              <dt>Ervaring:</dt>
              <dd>20 jaar</dd>
            </div>

            <div class="info-blok">
              <dt>Win rate:</dt>
              <dd>75%</dd>
            </div>

            <div class="info-blok">
              <dt>Mods:</dt>
              <dd>Stickers</dd>
            </div>
          </dl>
        </section>

        <section>
          <h2 id="tekst">Opmerkingen:</h2>
          <p id="tekst">
            Ik race alleen in de avond en met intermediate+. Dus geen beginners
          </p>
        </section>
    
      </section>
        
    </main>

    <footer><%- include('../partials/footer'); %></footer>

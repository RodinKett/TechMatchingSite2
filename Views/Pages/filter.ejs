<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>EJS Is Fun</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/filter.css" />
    <!-- CSS (load bootstrap from a CDN) -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.5.2/css/bootstrap.min.css"
    />

    <link rel="stylesheet" href="/style.css" />
    <link rel="stylesheet" href="/footer.css" />
  </head>
  <body>
    <header><%- include('../partials/headerbasis'); %></header>
    <main id="body-filter">
      <button id="button-filter">
        <p>Reset filters</p>
        <!-- data ophalen van hoeveelheid filters -->
        <p>(4)</p>
      </button>
      <section id="parent-alles">
        <!-- wielaandrijving -->
        <section class="filter-opties">
          <button class="button">Wielaanrijving</button>

          <label class="checkbox"><input type="checkbox" /> FWD</label>
          <label class="checkbox"><input type="checkbox" /> RWD</label>
          <label class="checkbox"><input type="checkbox" /> AWD</label>
        </section>

        <!-- Vermogen apk -->
        <section class="filter-opties">
          <button class="button">Vermogen APK</button>
          <!-- van -->
          <section class="van-tot">
            <select class="input-veld">
              <option value="">van</option>
              <option value="100">100</option>
              <option value="150">150</option>
              <option value="200">200</option>
              <option value="250">250</option>
            </select>

            <!-- tot -->
            <select class="input-veld" name="vermogen_tot">
              <option value="">tot</option>
              <option value="100">100</option>
              <option value="150">150</option>
              <option value="200">200</option>
              <option value="250">250</option>
            </select>
          </section>
        </section>

        <!-- jaartal -->
        <section class="filter-opties">
          <button class="button">Jaartal</button>
          <input
            class="input-veld"
            type="number"
            name="jaartal"
            placeholder="Bijvoorbeeld 2023"
          />
        </section>
        <!-- vaardigheid -->
        <section class="filter-opties">
          <button class="button">Vaardigheid</button>

          <label class="checkbox"><input type="checkbox" /> Beginner</label>
          <label class="checkbox"><input type="checkbox" /> Bevorderd</label>
          <label class="checkbox"><input type="checkbox" /> Ervaren</label>
          <label class="checkbox"><input type="checkbox" /> Expert</label>
        </section>

        <!-- Ervaring -->
        <section class="filter-opties">
          <button class="button">Jaren ervaring</button>
          <input
            class="input-veld"
            type="number"
            name="jaren ervaring"
            placeholder="Bijvoorbeeld 5"
          />
        </section>

        <!-- win rate -->
        <section class="filter-opties">
          <button class="button">Win rate</button>
          <!-- van -->
          <section class="van-tot">
            <select class="input-veld">
              <option value="">van</option>
              <option value="0%">0%</option>
              <option value="20%">20%</option>
              <option value="40%">40%</option>
              <option value="60%">60%</option>
              <option value="80%">80%</option>
            </select>

            <!-- tot -->
            <select class="input-veld">
              <option value="">tot</option>
              <option value="20%">20%</option>
              <option value="40%">40%</option>
              <option value="60%">60%</option>
              <option value="80%">80%</option>
              <option value="100%">100%</option>
            </select>
          </section>
        </section>

        <!-- Specialisatie -->
        <section class="filter-opties">
          <button class="button">Specialisatie</button>
          <label class="checkbox"><input type="checkbox" /> Driften</label>
          <label class="checkbox"><input type="checkbox" /> Snelheid</label>
          <label class="checkbox"><input type="checkbox" /> Donker</label>
          <label class="checkbox"><input type="checkbox" /> ....</label>
        </section>

        <!-- Mods -->
        <section class="filter-opties">
          <button class="button">Mods</button>
          <label class="checkbox"><input type="checkbox" /> mod 1</label>
          <label class="checkbox"><input type="checkbox" /> mod 2</label>
          <label class="checkbox"><input type="checkbox" /> mod 3</label>
          <label class="checkbox"><input type="checkbox" /> mod 4</label>
        </section>
      </section>

      <section id="resultaten-weergeven">
        <button>Resultaten weergeven</button>
      </section>
    </main>
  </body>
</html>

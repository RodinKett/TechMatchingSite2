<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>EJS Is Fun</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/filter.css" />

    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <header><%- include('../partials/headerbasis'); %></header>
    <main id="body-filter">
      <button id="button-filter">
        <p>Reset filters</p>
        <!-- data ophalen van hoeveelheid filters -->
        <p id="telling-filter"></p>
      </button>
      <section id="parent-alles">


               <!-- jaartal -->
        <section class="filter-opties">
          <button class="button">
            Jaartal
            <svg
              class="pijltje"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                fill="#fff"
                fill-rule="evenodd"
                d="M12.707 14.707a1 1 0 0 1-1.414 0l-5-5a1 1 0 0 1 1.414-1.414L12 12.586l4.293-4.293a1 1 0 1 1 1.414 1.414z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
          <input
            class="input-veld"
            type="number"
            name="jaartal"
            placeholder="Bijv 2023"
          />
        </section>

              <!-- vaardigheid -->
        <section class="filter-opties">
          <button class="button">
            Vaardigheid
            <svg
              class="pijltje"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                fill="var(--kleur-icons)"
                fill-rule="evenodd"
                d="M12.707 14.707a1 1 0 0 1-1.414 0l-5-5a1 1 0 0 1 1.414-1.414L12 12.586l4.293-4.293a1 1 0 1 1 1.414 1.414z"
                clip-rule="evenodd"
              />
            </svg>
          </button>

          <label class="checkbox"><input type="checkbox" /> Beginner</label>
          <label class="checkbox"><input type="checkbox" /> Bevorderd</label>
          <label class="checkbox"><input type="checkbox" /> Ervaren</label>
          <label class="checkbox"><input type="checkbox" /> Expert</label>
        </section>

        <!-- wielaandrijving -->
        <section class="filter-opties">
          <button class="button">
            Wielaanrijving
            <svg
              class="pijltje"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                fill="#fff"
                fill-rule="evenodd"
                d="M12.707 14.707a1 1 0 0 1-1.414 0l-5-5a1 1 0 0 1 1.414-1.414L12 12.586l4.293-4.293a1 1 0 1 1 1.414 1.414z"
                clip-rule="evenodd"
              />
            </svg>
          </button>

          <label class="checkbox"><input type="checkbox" /> FWD</label>
          <label class="checkbox"><input type="checkbox" /> RWD</label>
          <label class="checkbox"><input type="checkbox" /> AWD</label>
          <label class="checkbox"><input type="checkbox" /> 4WD</label>
        </section>

            <!-- Specialisatie -->
        <section class="filter-opties">
          <button class="button">Specialisatie
            <svg
            class="pijltje"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              fill="var(--kleur-icons)"
              fill-rule="evenodd"
              d="M12.707 14.707a1 1 0 0 1-1.414 0l-5-5a1 1 0 0 1 1.414-1.414L12 12.586l4.293-4.293a1 1 0 1 1 1.414 1.414z"
              clip-rule="evenodd"
            />
          </svg>
          </button>
          

          <label class="checkbox"><input type="checkbox" /> Circuit racing</label>
          <label class="checkbox"><input type="checkbox" /> Drag racing</label>
          <label class="checkbox"><input type="checkbox" /> Drift racing</label>
          <label class="checkbox"><input type="checkbox" /> Rally</label>
          <label class="checkbox"><input type="checkbox" /> Endurance racing</label>
        </section>

        <!-- pk -->
        <section class="filter-opties">
          <button class="button">
            PK
            <svg
              class="pijltje"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                fill="var(--kleur-icons)"
                fill-rule="evenodd"
                d="M12.707 14.707a1 1 0 0 1-1.414 0l-5-5a1 1 0 0 1 1.414-1.414L12 12.586l4.293-4.293a1 1 0 1 1 1.414 1.414z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
          <!-- van -->
          <section class="van-tot">
            <select class="input-veld">
              <option value="">van</option>
              <option value="100">100</option>
              <option value="150">150</option>
              <option value="200">200</option>
              <option value="250">250</option>
            </select>

            <!-- tot -->
            <select class="input-veld">
              <option value="">tot</option>
              <option value="100">100</option>
              <option value="150">150</option>
              <option value="200">200</option>
              <option value="250">250</option>
            </select>
          </section>
        </section>

 
  

        <!-- Ervaring -->
        <section class="filter-opties">
          <button class="button">
            Jaren ervaring
            <svg
              class="pijltje"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                fill="#fff"
                fill-rule="evenodd"
                d="M12.707 14.707a1 1 0 0 1-1.414 0l-5-5a1 1 0 0 1 1.414-1.414L12 12.586l4.293-4.293a1 1 0 1 1 1.414 1.414z"
                clip-rule="evenodd"
              />
            </svg>
          </button>

          <input
            class="input-veld"
            type="number"
            name="jaren ervaring"
            placeholder="Bijvoorbeeld 5"
          />
        </section>

        <!-- win rate -->
        <section class="filter-opties">
          <button class="button">
            Win rate
            <svg
              class="pijltje"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                fill="#fff"
                fill-rule="evenodd"
                d="M12.707 14.707a1 1 0 0 1-1.414 0l-5-5a1 1 0 0 1 1.414-1.414L12 12.586l4.293-4.293a1 1 0 1 1 1.414 1.414z"
                clip-rule="evenodd"
              />
            </svg>
          </button>

          <!-- van -->
          <section class="van-tot">
            <select class="input-veld">
              <option value="">van</option>
              <option value="0%">0%</option>
              <option value="20%">20%</option>
              <option value="40%">40%</option>
              <option value="60%">60%</option>
              <option value="80%">80%</option>
            </select>

            <!-- tot -->
            <select class="input-veld">
              <option value="">tot</option>
              <option value="20%">20%</option>
              <option value="40%">40%</option>
              <option value="60%">60%</option>
              <option value="80%">80%</option>
              <option value="100%">100%</option>
            </select>
          </section>
        </section>

    

        <!-- Mods -->
        <section class="filter-opties">
          <button class="button">
            Mods
            <svg
              class="pijltje"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                fill="#fff"
                fill-rule="evenodd"
                d="M12.707 14.707a1 1 0 0 1-1.414 0l-5-5a1 1 0 0 1 1.414-1.414L12 12.586l4.293-4.293a1 1 0 1 1 1.414 1.414z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
          <label class="checkbox"><input type="checkbox" /> Banden</label>
          <label class="checkbox"><input type="checkbox" /> Suspensie</label>
          <label class="checkbox"><input type="checkbox" /> Remmen</label>
          <label class="checkbox"><input type="checkbox" /> Power modus</label>
          <label class="checkbox"><input type="checkbox" /> Aero</label>
        </section>
      </section>

      <section id="resultaten-weergeven">
        <button>Resultaten weergeven</button>
      </section>
    </main>
    <script src="/js/filter.js"></script>
  </body>
</html>

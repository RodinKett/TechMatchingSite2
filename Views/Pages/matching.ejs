              <g stroke-linecap="round" stroke-width="2" clip-path="url(#a)">
                <path
                  stroke="#0c0310"
                  stroke-linejoin="round"
                  d="M5.333 6.667h16M5.333 16h8M18.667 16h8M10.667 25.333h16M24 9.333A2.667 2.667 0 1 0 24 4a2.667 2.667 0 0 0 0 5.333M16 18.667a2.667 2.667 0 1 0 0-5.334 2.667 2.667 0 0 0 0 5.334M8 28a2.667 2.667 0 1 0 0-5.333A2.667 2.667 0 0 0 8 28"

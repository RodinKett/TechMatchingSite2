              </g>
              <defs>
                <clipPath id="a">
                  <path fill="#fff" d="M0 0h32v32H0z" />
                </clipPath>
              </defs>
            </svg>
          </button>
          <p>rank 95</p>
          <img
            src="/afbeeldingen/lightning-mcqueen.png"
            alt="Lightning McQueen"
          />
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="327"
            height="11"
            fill="none"
          >
            <path
              fill="#fff"
              d="m173.913.003 152.173.002v4.961l-157.155-.002zM167.335 5.956l158.751.003v4.961l-163.948-.002zM152.174 10.917 0 10.915V5.954l157.155.002zM158.751 4.964 0 4.962V0l163.948.002z"
            />
          </svg>
          <h2 id="naam-gebruiker">Lightning Mcqueen</h2>
        </section>
        <section>
          <!-- links border -->
         
       
          <!-- rechts border -->
   

          <section id="info">
            <dl>
              <div class="info-blok">
                <dt>Voertuig:</dt>
                <dd>Gen 4 NASCAR</dd>
              </div>

              <div class="info-blok">
                <dt>PK</dt>
                <dd>260</dd>
              </div>

              <div class="info-blok">
                <dt>Jaar:</dt>
                <dd>2006</dd>
              </div>

              <div class="info-blok">
                <dt>Specialisatie:</dt>
                <dd>Bochten</dd>
              </div>

              <div class="info-blok">
                <dt>Ervaring:</dt>
                <dd>20 jaar</dd>
              </div>

              <div class="info-blok">
                <dt>Win rate:</dt>
                <dd>75%</dd>
              </div>

              <div class="info-blok">
                <dt>Mods:</dt>
                <dd>Stickers</dd>
              </div>
            </dl>
          </section>

          <section>
            <h2 class="tekst">Opmerkingen:</h2>
            <p class="tekst">
              Ik race alleen in de avond en met intermediate+. Dus geen
              beginners
            </p>
          </section>
        </section>
      </section>

      <section id="button-matching">
        <button type="button" id="button-volgende">Volgende</button>
        <button type="button" id="button-challenge">Challenge</button>
      </section>
    </main>

    <footer><%- include('../partials/footer'); %></footer>
  </body>
</html>
